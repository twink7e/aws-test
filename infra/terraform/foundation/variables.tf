variable "aws_region" {
  description = "AWS deployment Region; the interview requires Tokyo."
  type        = string
  default     = "ap-northeast-1"

  validation {
    condition     = var.aws_region == "ap-northeast-1"
    error_message = "This assessment must deploy in AWS Tokyo (ap-northeast-1)."
  }
}

variable "project_name" {
  description = "Lowercase prefix for resources. Keep <=23 characters for ALB/S3 names."
  type        = string
  default     = "poper-test"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,22}$", var.project_name))
    error_message = "Use 3-23 lowercase letters, digits and hyphens, starting with a letter."
  }
}

variable "environment" {
  description = "Environment tag and AppConfig environment name."
  type        = string
  default     = "interview"
}

variable "vpc_cidr" {
  description = "VPC CIDR. Keep subnet CIDRs within this range."
  type        = string
  default     = "10.42.0.0/16"
}

variable "public_subnet_cidrs" {
  description = "Two ALB/Fargate public subnet CIDRs, one per AZ."
  type        = list(string)
  default     = ["10.42.0.0/24", "10.42.1.0/24"]

  validation {
    condition     = length(var.public_subnet_cidrs) == 2
    error_message = "Exactly two public subnet CIDRs are required."
  }
}

variable "private_db_subnet_cidrs" {
  description = "Two isolated database subnet CIDRs, one per AZ."
  type        = list(string)
  default     = ["10.42.10.0/24", "10.42.11.0/24"]

  validation {
    condition     = length(var.private_db_subnet_cidrs) == 2
    error_message = "Exactly two private DB subnet CIDRs are required."
  }
}

variable "acm_certificate_arn" {
  description = "Existing ACM certificate in this Region for HTTPS. Null serves HTTP on the ALB DNS name."
  type        = string
  default     = null
  nullable    = true
}

variable "db_name" {
  description = "PostgreSQL database name."
  type        = string
  default     = "poper"
}

variable "db_username" {
  description = "PostgreSQL master username. Password is generated by RDS in Secrets Manager."
  type        = string
  default     = "poperadmin"
}

variable "db_instance_class" {
  description = "Low-cost single-AZ instance class. Confirm Regional availability before apply."
  type        = string
  default     = "db.t4g.micro"
}

variable "db_allocated_storage_gib" {
  description = "Initial RDS storage in GiB. RDS storage can grow but cannot shrink in place."
  type        = number
  default     = 20
}

variable "db_max_allocated_storage_gib" {
  description = "Optional RDS storage autoscaling ceiling. Null disables auto-growth to avoid surprise cost."
  type        = number
  default     = null
  nullable    = true
}

variable "log_retention_days" {
  description = "CloudWatch log retention for app, web, agent, backup, ALB, and RDS logs."
  type        = number
  default     = 7
}

variable "backup_retention_days" {
  description = "S3 pg_dump object expiration period."
  type        = number
  default     = 7
}

variable "force_destroy_backup_bucket" {
  description = "Explicit opt-in for deleting all backup objects during terraform destroy."
  type        = bool
  default     = false
}

variable "alert_email_addresses" {
  description = "Email recipients. SNS sends a confirmation link to each address before notifications work."
  type        = set(string)
  default     = []
}

variable "appconfig_initial_content" {
  description = "Initial hosted AppConfig JSON, managed as a versioned deployment."
  type        = string
  default     = "{\"homepage_message\":\"Hello from AppConfig\",\"maintenance_mode\":false}"

  validation {
    condition     = can(jsondecode(var.appconfig_initial_content))
    error_message = "appconfig_initial_content must be valid JSON."
  }
}

variable "appconfig_use_gradual_deployment" {
  description = "False for the first bootstrap deployment; set true before changing AppConfig JSON for later releases."
  type        = bool
  default     = false
}

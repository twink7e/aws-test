APP_NAME="POPER Operations Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:18080

LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=poper
DB_USERNAME=poper
DB_PASSWORD=

DEMO_MESSAGE="Hello from the environment"
APPCONFIG_URL=http://127.0.0.1:2772/applications/poper-test/environments/demo/configurations/homepage
ENABLE_DEMO_FAILURE_ROUTES=false
